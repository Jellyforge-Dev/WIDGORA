<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV only. Touch input is never assumed. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      App widgets are an addition, never the product. A device either hosts widgets or it does
      not, and WIDGORA works the same either way, so requiring the feature would hide the
      application from a store on a device perfectly able to run it. Observed: a television
      running Android 14 declares this feature, a Google TV system image at API level 36 does not.
    -->
    <uses-feature
        android:name="android.software.app_widgets"
        android:required="false" />

    <!-- The only two permissions the first milestone asks for, as stated in SECURITY.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".WidgoraApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner_placeholder"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_placeholder"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Widgora">

        <!--
          windowSoftInputMode: the on-screen keyboard must not cover the field being typed into.
          Up to Android 14 — which is what the television runs — this is what shortens the window
          so that the form can scroll inside what is left. From Android 15 the platform no longer
          resizes the window of an application that draws edge to edge, and the screen's own
          imePadding takes over instead; the two are complementary, and the screen says so where
          it applies that padding. Unverified until both have been seen on a device.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The configuration step a host runs when a widget is placed.

          It is exported, and it has to be: the party that starts it is the host launcher, in
          another process, and an activity a launcher cannot start is a configuration step that
          never runs. The intent filter carries the action the platform documents for this purpose.

          Exported means any application on the device can start it with any identifier, so the
          identifier is checked against the widget manager rather than believed — see
          WidgetConfigRequests, and SECURITY.md for what that defends against and what the screen
          does not hold in the first place. There is no address, no credential and no monitor name
          on it.

          No windowSoftInputMode: the screen has no text field at all. Every answer on it is a
          choice between things that already exist, so no on-screen keyboard appears.
        -->
        <activity
            android:name=".widget.config.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          The widget. It is not exported: the only thing that talks to it is the system's own
          widget service, and nothing else has any business sending it a broadcast. All four
          actions below are intents the platform documents as protected and sendable by the
          system alone, so declaring them opens nothing to anybody.

          Beside the update: two that start and stop the periodic refresh — the first widget of
          this provider appearing, and the last one going away — and one that names the widgets
          which have been removed, so that their stored settings can go with them.

          They are declared although the documentation does not say they must be. What it does
          say is that the filter has to accept APPWIDGET_UPDATE; about the others it says nothing
          either way, and whether they arrive as explicit intents addressed to this component is
          not stated on any page that was checked. Declaring them makes the manifest correct
          under either answer, which is cheaper than depending on one that was guessed at.
        -->
        <receiver
            android:name=".widget.CountsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_ENABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DISABLED" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/counts_widget_info" />
        </receiver>

    </application>

</manifest>
