<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget at the smallest size it is declared to accept.

  Three rows rather than four: the state and the time share the bottom line. Nothing is dropped
  to achieve that — the state still carries both its mark and its word, and the time is still
  there — and no text size falls below the floor the design system sets for a screen three metres
  away.

  The full variant was cut off on a television at this size, which is what this layout exists to
  fix: four lines of television-sized text need about 170dp and the declared default is 160dp. An
  instrumented test measures both variants at their smallest size, because arithmetic in a
  comment is not a measurement.

  The identifiers match the full variant exactly, so one piece of code fills either.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_open_app"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding_compact">

    <!--
      The title, and beside it the count of the affected items the title has no room to name.

      Two views rather than one text, for the reason the state and the time below are two: the
      part that may be shortened and the part that may not are different parts. With the user's
      consent the title names the first failed monitor, and the count of the others keeps its own
      width while the name gives way — in a single text ending in "+2" the ellipsis would eat the
      "+2" first, which is the one piece of it that cannot be inferred from anything else.

      Without consent, or with nothing wrong, the count stays gone and the title is the instance's
      name, exactly as before.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_compact_title" />

        <TextView
            android:id="@+id/widget_title_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_compact"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="@dimen/widget_text_compact_title"
            android:visibility="gone" />

    </LinearLayout>

    <!--
      The counts take the height the other two lines leave and are scaled to fill it.

      At the declared minimum that spare height was a third of the widget, sitting empty under
      text that was too small to read across a room. It belongs to the counts, which are the
      reason anybody looks at this. The same scaling keeps all five marks on the line in a narrow
      box by shrinking rather than shortening — never below the floor the range names.
    -->
    <TextView
        android:id="@+id/widget_counts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="@dimen/widget_counts_autosize_max_compact"
        android:autoSizeMinTextSize="@dimen/widget_counts_autosize_min"
        android:autoSizeStepGranularity="@dimen/widget_counts_autosize_step"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_text_compact_counts"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!--
          The time keeps its own width; the state takes what is left and shortens itself if it
          has to. That order is the one compromise this variant makes, and it is deliberate.

          Some state wordings are long — "Not found: address or interface" does not fit beside a
          time at television text sizes in 300dp. One of the two has to give, and a shortened
          time is worthless ("at 1…") while a shortened state still carries its mark, which is
          the channel that identifies the state unambiguously anyway. So the word is the part
          that may shorten, never the time and never the mark.
        -->
        <TextView
            android:id="@+id/widget_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/dashboard_state_loading"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="@dimen/widget_text_compact_line" />

        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_compact"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/dashboard_no_data_yet"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="@dimen/widget_text_compact_line" />

    </LinearLayout>

</LinearLayout>
