<?xml version="1.0" encoding="utf-8"?>
<!--
  A list widget at the smallest box it accepts: two items.

  ### Why two

  Measured rather than chosen. The box is 300 x 170 dp, of which the host's own padding takes
  24 dp of height, leaving 146 dp. Four lines of text at the project's floor of 18 sp, at a font
  scale of 1.3, need about 131 dp of that — a title line, two items, and the state with the time
  sharing the bottom line. A fifth line does not fit at that scale, and lowering the text instead
  is not on offer: 18 sp is the floor for a surface read from three metres away.

  ### Why the padding is 4 dp here

  The host already puts 12 / 4 / 12 / 20 dp around the widget. A further 16 dp all round would
  spend height this box does not have on a margin that is already there.

  ### The three parts

  A title line, which also carries how many items were left out; the items; and the bottom line,
  where the state gives way before the time does — a shortened time is worthless, a shortened
  state word still carries its mark.

  Every item is two views. The name may be shortened and the figure beside it may not, which is
  the same division the bottom line makes and for the same reason: half a number is nothing.

  The identifiers match the other two list layouts exactly, so one piece of code fills any of them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_open_app"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding_tiny">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_text_list_title" />

        <TextView
            android:id="@+id/widget_title_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_compact"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="@dimen/widget_text_list_title"
            android:visibility="gone" />

    </LinearLayout>

    <!--
      The items take the room the two fixed lines leave and sit in the middle of it. With fewer
      items than the box holds, the gap is above and below them rather than under the last one.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!--
          Nothing to list is a statement rather than a gap, so it gets the space the items would
          have had and up to three lines to say it in. The title line is hidden while it shows:
          with no item on the surface, the message is the content.
        -->
        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="@dimen/widget_text_list_row"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_row_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_text_list_row"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_row_0_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_padding_compact"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_muted"
                android:textSize="@dimen/widget_text_list_row"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_row_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="@dimen/widget_text_list_row"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_row_1_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_padding_compact"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_muted"
                android:textSize="@dimen/widget_text_list_row"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/dashboard_state_loading"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="@dimen/widget_text_list_row" />

        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_padding_compact"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/dashboard_no_data_yet"
            android:textColor="@color/widget_on_surface_muted"
            android:textSize="@dimen/widget_text_list_row" />

    </LinearLayout>

</LinearLayout>
