<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The product name is not translated, in any language. -->
    <string name="app_name" translatable="false">WIDGORA</string>
    <string name="home_settings_action">Settings</string>

    <string name="dashboard_refresh">Refresh</string>
    <string name="dashboard_no_instance">No instance set up yet. Open the settings to add one.</string>
    <string name="dashboard_no_data_yet">No data yet.</string>
    <string name="dashboard_last_updated">Last updated: %1$s</string>
    <string name="dashboard_last_updated_outdated">No longer current. Last successful update: %1$s</string>

    <string name="dashboard_state_loading">Loading…</string>
    <string name="dashboard_state_ok">Current</string>
    <string name="dashboard_state_empty">Nothing to report</string>
    <string name="dashboard_state_stale">Outdated</string>
    <string name="dashboard_state_offline">Not reachable</string>
    <string name="dashboard_state_error_unauthorized">Key rejected</string>
    <string name="dashboard_state_error_endpoint_not_found">Not found: address or interface</string>
    <string name="dashboard_state_error_malformed">Answer not readable</string>
    <string name="dashboard_state_error_oversized">Answer too large</string>
    <string name="dashboard_state_error_unknown">Retrieval failed</string>

    <!--
      Storage exists and could not be read. Deliberately not the wording of
      dashboard_no_instance: what is true differs, and so does what the user has to do.
    -->
    <string name="dashboard_config_unreadable">The saved settings cannot be read. Your instance is still there but could not be loaded. Open the settings and save it again.</string>

    <!--
      The actions a tile offers. Neither is drawn on the tile: they are the labels a screen reader
      announces for the directional pad's centre key, so the tile stays uncluttered. Which one
      applies, or neither, is decided by TileAction.
    -->
    <string name="dashboard_open_details">Show the individual monitors</string>
    <string name="dashboard_open_settings">Open the settings</string>
    <!--
      How many affected monitors did not fit on the tile. A plural because a language that
      inflects the word after the number needs both forms; English does not distinguish them.
    -->
    <plurals name="dashboard_affected_more">
        <item quantity="one">+%1$d more</item>
        <item quantity="other">+%1$d more</item>
    </plurals>

    <!-- One monitor's state in a word. Shown in the detail list, read out on the tile. -->
    <string name="monitor_state_active">up</string>
    <string name="monitor_state_failed">down</string>
    <string name="monitor_state_pending">pending</string>
    <string name="monitor_state_maintenance">in maintenance</string>
    <string name="monitor_state_unknown">unknown</string>

    <!--
      The neutral half of a monitor note: what is the matter, in words that name no service. The
      other half, what to do about it, comes from the integration that reported the item and is
      appended after this sentence; see MonitorNote.
    -->
    <string name="monitor_note_contradictory">Contradictory information from the source.</string>

    <string name="detail_back_hint">Press back to return to the dashboard.</string>
    <string name="detail_no_monitors">No monitors retrieved yet.</string>
    <!-- A measured response time. The unit is not translated. -->
    <string name="detail_response_time">%1$d ms</string>

    <string name="dashboard_notice_disabled">Switched off.</string>
    <string name="dashboard_notice_secret_unusable">The API key is missing or can no longer be read. Please enter it again in the settings.</string>
    <string name="dashboard_notice_entry_invalid">This instance is stored invalidly. Correct it in the settings or delete it.</string>

    <!--
      The parts of the summary. Each one is a whole phrase, so a translation decides for itself
      where the number goes. They are plurals so that a language needing separate forms has them
      available; neither of the two languages shipped inflects these words.
      Keep them short: a snapshot value holds at most 64 characters, and five parts at once can
      reach that.
    -->
    <plurals name="summary_up">
        <item quantity="one">%1$d up</item>
        <item quantity="other">%1$d up</item>
    </plurals>
    <plurals name="summary_down">
        <item quantity="one">%1$d down</item>
        <item quantity="other">%1$d down</item>
    </plurals>
    <plurals name="summary_pending">
        <item quantity="one">%1$d pending</item>
        <item quantity="other">%1$d pending</item>
    </plurals>
    <plurals name="summary_maintenance">
        <item quantity="one">%1$d in maintenance</item>
        <item quantity="other">%1$d in maintenance</item>
    </plurals>
    <plurals name="summary_unknown">
        <item quantity="one">%1$d unknown</item>
        <item quantity="other">%1$d unknown</item>
    </plurals>
    <string name="summary_separator">", "</string>

    <!--
      The widget. Its label and description are read by a host's widget picker, so both are short
      and say what the widget shows rather than what the product is.
    -->
    <string name="widget_label">Status overview</string>
    <string name="widget_description">Counts per state for one instance.</string>
    <!-- Spoken for the widget as a whole; pressing it opens the application and nothing else. -->
    <string name="widget_open_app">Open WIDGORA</string>
    <string name="widget_not_set_up">Not set up yet. Open WIDGORA to add an instance.</string>
    <!--
      Deliberately shorter than the message the dashboard shows for the same situation: a widget
      has four lines, and the sentence explaining what to do belongs on the screen that offers it.
    -->
    <string name="widget_config_unreadable">The saved settings cannot be read.</string>

    <string name="settings_title">Uptime Kuma instance</string>
    <string name="settings_back_hint">Press back to leave this screen.</string>

    <string name="settings_display_name">Name</string>
    <string name="settings_address">Address</string>
    <string name="settings_address_hint">https://kuma.example.com</string>
    <string name="settings_api_key">API key</string>

    <string name="settings_api_key_new">Create a key in Uptime Kuma under Settings, API keys.</string>
    <string name="settings_api_key_stored">Key saved. Leave empty to keep it.</string>
    <string name="settings_api_key_unreadable">The saved key can no longer be read and has to be entered again.</string>

    <string name="settings_invalid_entry">This saved instance no longer meets the rules. Correct it or delete it.</string>

    <string name="settings_save">Save</string>
    <string name="settings_test">Test connection</string>
    <string name="settings_delete">Delete</string>
    <string name="settings_delete_question">Delete this instance, its key and its stored data?</string>
    <string name="settings_delete_confirm">Yes, delete</string>
    <string name="settings_delete_cancel">Keep</string>

    <!--
      Storage that exists and cannot be read, said on the screen that can do something about it.
      It names both ways out, in the order they should be tried: entering the instance again keeps
      nothing of the old file, resetting throws it away deliberately.
    -->
    <string name="settings_config_unreadable">The saved settings cannot be read. You can enter the instance again and save it, or reset the saved settings.</string>

    <!--
      Only shown while the configuration is unreadable. The question repeats what is lost, because
      this is the one action in the application that cannot be undone and that removes key material
      as well as settings.
    -->
    <string name="settings_reset">Reset saved settings</string>
    <string name="settings_reset_question">Remove the saved settings, the saved key and its key material? This cannot be undone.</string>
    <string name="settings_reset_confirm">Yes, reset</string>
    <string name="settings_reset_cancel">Keep</string>
    <string name="settings_reset_done">The saved settings have been removed. You can set the instance up again.</string>

    <string name="settings_saved">Saved.</string>

    <!--
      A write that did not happen. Saying so is the whole point: the previous version let the
      attempt fail silently, and the user was left looking at values that were never stored.
    -->
    <string name="settings_error_save_failed">Could not be saved. The settings file cannot be written.</string>
    <string name="settings_error_delete_failed">Could not be deleted. The settings file cannot be written.</string>
    <string name="settings_error_reset_failed">The saved settings could not be removed.</string>

    <string name="settings_error_display_name_required">Please enter a name.</string>
    <string name="settings_error_api_key_required">Please enter the API key.</string>
    <string name="settings_error_api_key_for_changed_address">The address has changed. Please enter the API key again: the saved one belongs to the previous address and is not sent anywhere else.</string>

    <string name="settings_address_error_not_an_address">That is not a complete address. It has to start with https://.</string>
    <string name="settings_address_error_not_https">Only encrypted addresses are accepted. Please use https://.</string>
    <string name="settings_address_error_host_missing">The address names no host.</string>
    <string name="settings_address_error_credentials_in_address">Please remove the user name and password from the address. The key belongs in the field below.</string>
    <string name="settings_address_error_query_not_allowed">Please remove the part after the question mark.</string>
    <string name="settings_address_error_fragment_not_allowed">Please remove the part after the number sign.</string>

    <string name="settings_test_running">Testing…</string>
    <string name="settings_test_reachable">Connected. Monitors found: %1$d.</string>
    <string name="settings_test_unauthorized">The key was rejected. Please check it.</string>
    <string name="settings_test_endpoint_not_found">Not found. Either the address is wrong, or the Prometheus interface is switched off in Uptime Kuma under Settings, API keys.</string>
    <string name="settings_test_unreachable">Not reachable. The server did not answer, or its certificate was not accepted.</string>
    <string name="settings_test_malformed">The answer could not be read. Is this address an Uptime Kuma installation?</string>
    <string name="settings_test_oversized">The answer was too large and was discarded.</string>
    <string name="settings_test_unknown">The attempt failed for an unknown reason.</string>
    <string name="settings_test_address_rejected">The address was refused before anything was sent. Only https is accepted.</string>
</resources>
