<?xml version="1.0" encoding="utf-8"?>
<!--
  The design tokens the widget needs as resources.

  A widget is drawn from an XML layout in another process, so the values a layout fixes cannot be
  read from the Kotlin tokens the rest of the application uses. They have to exist a second time,
  here. Two copies of a number is exactly how two surfaces of one product drift apart, so every
  value below is checked against its Kotlin original by a test, and a change made on one side and
  not the other fails the build.

  Only the values a layout fixes are here. A colour that depends on the state is not: it is read
  from WidgetPresentation at the moment the views are built, which is the same value the dashboard
  tile reads, so there is nothing to keep in step.
-->
<resources>

    <!-- WidgoraColors.Surface -->
    <color name="widget_surface">#FF12121C</color>
    <!-- WidgoraColors.OnSurface -->
    <color name="widget_on_surface">#FFF2F2F7</color>
    <!-- WidgoraColors.OnSurfaceMuted -->
    <color name="widget_on_surface_muted">#FFC3C5D4</color>
    <!-- WidgoraColors.Outline -->
    <color name="widget_outline">#FF666A85</color>
    <!-- WidgoraColors.Focus -->
    <color name="widget_focus">#FFFFFFFF</color>

    <!--
      WidgoraShapes.TileCornerRadius. The platform states that a widget background's radius is
      never larger than 28dp, and this is well inside that.
    -->
    <dimen name="widget_corner_radius">12dp</dimen>
    <!-- WidgoraSpacing.Medium -->
    <dimen name="widget_padding">16dp</dimen>
    <!--
      WidgoraSpacing.Small, for the compact variant.

      Smaller than the full variant's, on purpose. A host already puts a padding of its own around
      a widget — measured at 12/4/12/20 dp on Android 14 — so adding another 16dp all round spends
      height the compact variant does not have on a margin that is already there.
    -->
    <dimen name="widget_padding_compact">8dp</dimen>
    <!-- WidgoraFocus.BorderWidth -->
    <dimen name="widget_focus_border">4dp</dimen>
    <!-- WidgoraFocus.RestingBorderWidth -->
    <dimen name="widget_resting_border">1dp</dimen>

    <!-- WidgoraText.TileTitle.size -->
    <dimen name="widget_text_title">26sp</dimen>
    <!-- WidgoraText.TileValue.size -->
    <dimen name="widget_text_counts">44sp</dimen>
    <!-- WidgoraText.Label.size -->
    <dimen name="widget_text_state">20sp</dimen>
    <!-- WidgoraText.Caption.size -->
    <dimen name="widget_text_footer">18sp</dimen>
    <!--
      WidgoraText.Caption.size — the affected monitors, where the user allowed them to be named.

      The floor rather than the tile's 20sp, and that follows from the surface rather than from a
      preference: the names are an addition to a widget that already carries four lines, so they
      take the smallest size this project permits anywhere. Whether three of them fit at every
      font scale is a question for the measurement test and not for this comment.
    -->
    <dimen name="widget_text_names">18sp</dimen>

    <!--
      The compact variant's three sizes. Smaller than the full variant's, every one of them still
      well above the 18sp floor, and each one chosen because the larger value does not fit the
      box the widget is declared for once the host's own padding is taken off it.
    -->
    <!-- WidgoraText.Label.size -->
    <dimen name="widget_text_compact_title">20sp</dimen>
    <!-- WidgoraText.WidgetValue.size -->
    <dimen name="widget_text_compact_counts">28sp</dimen>
    <!-- WidgoraText.Caption.size -->
    <dimen name="widget_text_compact_line">18sp</dimen>

    <!--
      The range the counts line is scaled within.

      A widget's box belongs to its host, so the counts are not given a size — they are given a
      range and the room, and the platform picks the largest size that fits both. That is what
      makes a large widget show large numbers, and a narrow one show all five marks instead of
      shortening them. The two fixed sizes above stay as the fallback for a platform that ignores
      the scaling; without them the text would fall back to a platform default well below the
      floor this project sets.
    -->
    <!-- WidgoraText.Minimum -->
    <dimen name="widget_counts_autosize_min">18sp</dimen>
    <!-- WidgoraText.WidgetValueMaximum -->
    <dimen name="widget_counts_autosize_max">96sp</dimen>
    <!--
      WidgoraText.TileValue.size — the ceiling for the compact variant alone.

      Measured: left to grow to the full ceiling, the counts filled the smallest box so
      completely that only 12 % of its height was free, and the safety margin this project asks
      for is 15 %. "As large as possible while 15 % stays free" is the rule, and this is the
      figure that keeps it: a dashboard tile's value size, which is as large as that line gets
      anywhere else in the application.
    -->
    <dimen name="widget_counts_autosize_max_compact">44sp</dimen>
    <!--
      WidgoraText.TileValue.size again — the ceiling for the step that also names monitors.

      Measured, like the one above. Left to grow to the full ceiling the counts line reached 94sp
      and took 257px of a 592px box, leaving 10 % of the height spare against a floor of 15 %
      once three names and an overflow count sat beneath it. The same figure as the compact
      ceiling and for the same reason: a dashboard tile's value size is as large as this line
      gets anywhere else in the application.
    -->
    <dimen name="widget_counts_autosize_max_named">44sp</dimen>
    <!-- WidgoraText.AutoSizeStep -->
    <dimen name="widget_counts_autosize_step">2sp</dimen>

</resources>
