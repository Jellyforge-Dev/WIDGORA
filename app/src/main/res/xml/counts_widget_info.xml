<?xml version="1.0" encoding="utf-8"?>
<!--
  What a host is told about this widget before it ever draws one.

  updatePeriodMillis is zero, which switches the widget framework's own periodic update off. Its
  floor is thirty minutes and it wakes a sleeping device in order to run; on a television that
  means waking up to fetch data nobody is looking at. WIDGORA pushes its own updates instead.

  One size, deliberately. The cell grid belongs to the host, and the host this is aimed at does
  not exist yet, so a second size would be a guess dressed up as a choice. The dp figures are what
  decides on a host without a grid, and the cell figures are what decides on one with a grid from
  Android 12 onwards; both are given because a host that ignores one reads the other.

  There is no android:configure yet. Choosing which instance a widget shows, and whether it may
  name individual monitors, is a later step; until then a widget shows the first instance and
  never a name.

  previewLayout is read from Android 12 onwards and renders this widget's own layout at its
  default size, which is why that layout's default texts say that nothing has loaded rather than
  showing a specimen value. Below Android 12 a host falls back to previewImage, and there is none,
  so such a host shows the application icon in its picker.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_counts"
    android:maxResizeHeight="320dp"
    android:maxResizeWidth="640dp"
    android:minHeight="160dp"
    android:minResizeHeight="120dp"
    android:minResizeWidth="240dp"
    android:minWidth="300dp"
    android:previewLayout="@layout/widget_counts"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
